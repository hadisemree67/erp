# ────────────────────────────────────────────────
# GÜVENLİ ŞABLON — Gerçek bilgilerinizi buraya yazıp
# dosyayı .env olarak kaydedin
# ────────────────────────────────────────────────

# ═══════════════════════════════════════════════
# Veritabanı Ayarları
# ═══════════════════════════════════════════════
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sifrenizi_girin
DB_NAME=e_ticaret_depo

# Prisma ORM bağlantı URL'si
DATABASE_URL="mysql://root:sifrenizi_girin@localhost:3306/e_ticaret_depo"

# ═══════════════════════════════════════════════
# Sunucu Ayarları
# ═══════════════════════════════════════════════
PORT=3000
BASE_URL=http://localhost:3000

# ═══════════════════════════════════════════════
# Güvenlik
# ═══════════════════════════════════════════════
# JWT gizli anahtarı (openssl rand -hex 64 ile oluşturabilirsiniz)
JWT_SECRET=buraya_guclu_bir_secret_key_girin

# ═══════════════════════════════════════════════
# E-posta (SMTP) Ayarları
# ═══════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email_adresiniz@gmail.com
SMTP_PASS=gmail_uygulama_sifreniz

# ═══════════════════════════════════════════════
# Docker Compose Ayarları
# ═══════════════════════════════════════════════
MYSQL_ROOT_PASSWORD=sifrenizi_girin
MYSQL_DATABASE=erp_db
VITE_API_URL=http://localhost:3000
