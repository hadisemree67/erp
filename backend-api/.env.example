# ────────────────────────────────────────────────
# Backend API — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin
# ────────────────────────────────────────────────

# Sunucu
PORT=3000

# MySQL Bağlantısı
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sifrenizi_girin
DB_NAME=e_ticaret_depo

# Prisma ORM
DATABASE_URL="mysql://root:sifrenizi_girin@localhost:3306/e_ticaret_depo"

# Güvenlik
JWT_SECRET=openssl_rand_hex_64_ile_olusturun
BASE_URL=http://localhost:3000

# E-posta (SMTP) — Gmail App Password kullanın
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email@gmail.com
SMTP_PASS=gmail_uygulama_sifresi
